<?xml version="1.0" encoding="UTF-8" ?>

<section xml:id="section-consistency" >
<title>Consistency</title>

        <definition>
            <title>Five Point Geometry</title>
            <statement><p>Use the following axioms and definitions of intersection and parallel as an alleged definition of the five point geometry.</p>
            <p><ol>
                    <li>There exist exactly five points.</li>
                    <li>There exist exactly five lines.</li>
                    <li>Any two distinct points have exactly one line on both of them.</li>
                    <li>Each line is on exactly two points.</li>
            </ol></p>
            </statement>
        </definition>

        <exercise>
            <introduction>
                <p>Explore the alleged five point geometry as follows.</p>
            </introduction>
            <task>
                <statement><p>Draw five points using Geogebra.</p></statement>
            </task>
            <task>
                <statement><p>Use Axiom 3 to draw all required lines.</p></statement>
            </task>
            <task>
                <statement><p>How many lines did you construct?</p></statement>
            </task>
            <task>
                <statement><p>Compare this answer to Axiom 2.</p></statement>
            </task>
        </exercise>
</section>
